<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingVertical="12dp"
    tools:context=".feature.masqueGenerator.AddMasqueActivity"
    tools:ignore="NestedWeights,TooManyViews">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/title_create_new_masque"
        android:textColor="@color/colorText"
        android:textSize="24sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/formContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="24dp"
            android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:text="@string/warp_section_endpoint_keys"
                    android:textColor="@color/color_secondary"
                    android:textSize="14sp" />


            </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/tv_masque_ip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:text="@string/warp_ip"
                        android:textColor="@color/colorText"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/edt_masque_ip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_edit_field"
                        android:hint="@string/masque_hint_ip"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLines="1"
                        android:nextFocusLeft="@+id/edt_masque_ip"
                        android:nextFocusRight="@+id/edt_masque_private_key"
                        android:nextFocusUp="@+id/edt_masque_ip"
                        android:nextFocusDown="@+id/edt_masque_port"
                        android:textColor="@color/colorText"
                        android:textColorHint="@color/color_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:alpha="0.3"
                    android:background="@color/color_secondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/tv_masque_port"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:text="@string/warp_port"
                        android:textColor="@color/colorText"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/edt_masque_port"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_edit_field"
                        android:hint="@string/masque_hint_port"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLines="1"
                        android:nextFocusLeft="@+id/edt_masque_port"
                        android:nextFocusRight="@+id/edt_masque_sni"
                        android:nextFocusUp="@+id/edt_masque_ip"
                        android:nextFocusDown="@+id/sp_masque_gen_transport"
                        android:textColor="@color/colorText"
                        android:textColorHint="@color/color_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:alpha="0.3"
                    android:background="@color/color_secondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/tv_masque_transport"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:text="@string/masque_transport_label"
                        android:textColor="@color/colorText"
                        android:textSize="14sp" />

                    <Spinner
                        android:id="@+id/sp_masque_gen_transport"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:popupBackground="@drawable/bg_spinner_dropdown"
                        android:entries="@array/masque_transport"
                        android:nextFocusLeft="@+id/sp_masque_gen_transport"
                        android:nextFocusRight="@+id/sp_masque_gen_allow_insecure"
                        android:nextFocusUp="@+id/edt_masque_port"
                        android:nextFocusDown="@+id/edt_masque_local_address" />

                </LinearLayout>
                <TextView
                    android:id="@+id/tv_masque_check_result"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/masque_gen_check_idle"
                    android:textColor="@color/color_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/tv_masque_private_key"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:text="@string/warp_private_key"
                        android:textColor="@color/colorText"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/edt_masque_private_key"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_edit_field"
                        android:gravity="top"
                        android:hint="@string/masque_hint_private_key"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine"
                        android:maxLines="4"
                        android:nextFocusLeft="@+id/edt_masque_ip"
                        android:nextFocusRight="@+id/button_masque_new_ip"
                        android:nextFocusUp="@+id/edt_masque_private_key"
                        android:nextFocusDown="@+id/edt_masque_sni"
                        android:textColor="@color/colorText"
                        android:textColorHint="@color/color_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:alpha="0.3"
                    android:background="@color/color_secondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/tv_masque_sni"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:text="@string/masque_sni_label"
                        android:textColor="@color/colorText"
                        android:textSize="14sp" />

                    <EditText
                        android:id="@+id/edt_masque_sni"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_edit_field"
                        android:hint="@string/masque_hint_sni"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLines="1"
                        android:nextFocusLeft="@+id/edt_masque_port"
                        android:nextFocusRight="@+id/button_masque_new_key"
                        android:nextFocusUp="@+id/edt_masque_private_key"
                        android:nextFocusDown="@+id/sp_masque_gen_allow_insecure"
                        android:textColor="@color/colorText"
                        android:textColorHint="@color/color_secondary"
                        android:textSize="14sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:alpha="0.3"
                    android:background="@color/color_secondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingVertical="12dp">

                    <TextView
                        android:id="@+id/tv_masque_allow_insecure"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.5"
                        android:text="@string/masque_insecure_label"
                        android:textColor="@color/colorText"
                        android:textSize="14sp" />

                    <Spinner
                        android:id="@+id/sp_masque_gen_allow_insecure"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:popupBackground="@drawable/bg_spinner_dropdown"
                        android:entries="@array/masque_gen_allow_insecure"
                        android:nextFocusLeft="@+id/sp_masque_gen_transport"
                        android:nextFocusRight="@+id/button_masque_paste"
                        android:nextFocusUp="@+id/edt_masque_sni"
                        android:nextFocusDown="@+id/edt_masque_wnoise" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:text="@string/warp_section_tunnel_settings"
            android:textColor="@color/color_secondary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">

                        <TextView
                            android:id="@+id/tv_masque_local_address"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.5"
                            android:text="@string/warp_local_address"
                            android:textColor="@color/colorText"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/edt_masque_local_address"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_edit_field"
                            android:hint="@string/warp_hint_local_address"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:maxLines="1"
                            android:nextFocusLeft="@+id/edt_masque_local_address"
                            android:nextFocusRight="@+id/edt_masque_keepalive"
                            android:nextFocusUp="@+id/sp_masque_gen_transport"
                            android:nextFocusDown="@+id/edt_masque_mtu"
                            android:textColor="@color/colorText"
                            android:textColorHint="@color/color_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:alpha="0.3"
                        android:background="@color/color_secondary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">

                        <TextView
                            android:id="@+id/tv_masque_mtu"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.5"
                            android:text="@string/warp_mtu"
                            android:textColor="@color/colorText"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/edt_masque_mtu"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_edit_field"
                            android:hint="@string/warp_hint_mtu"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLines="1"
                            android:nextFocusLeft="@+id/edt_masque_mtu"
                            android:nextFocusRight="@+id/edt_masque_remark"
                            android:nextFocusUp="@+id/edt_masque_local_address"
                            android:nextFocusDown="@+id/edt_masque_dns"
                            android:textColor="@color/colorText"
                            android:textColorHint="@color/color_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:alpha="0.3"
                        android:background="@color/color_secondary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">

                        <TextView
                            android:id="@+id/tv_masque_dns"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.5"
                            android:text="@string/masque_dns_label"
                            android:textColor="@color/colorText"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/edt_masque_dns"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_edit_field"
                            android:hint="@string/masque_hint_dns"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:maxLines="1"
                            android:nextFocusLeft="@+id/edt_masque_dns"
                            android:nextFocusRight="@+id/edt_masque_remark"
                            android:nextFocusUp="@+id/edt_masque_mtu"
                            android:nextFocusDown="@+id/edt_masque_wnoise"
                            android:textColor="@color/colorText"
                            android:textColorHint="@color/color_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">

                        <TextView
                            android:id="@+id/tv_masque_keepalive"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.5"
                            android:text="@string/warp_keepalive"
                            android:textColor="@color/colorText"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/edt_masque_keepalive"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_edit_field"
                            android:hint="@string/warp_hint_keepalive"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="no"
                            android:inputType="numberSigned"
                            android:maxLines="1"
                            android:nextFocusLeft="@+id/edt_masque_local_address"
                            android:nextFocusRight="@+id/button_masque_clear"
                            android:nextFocusUp="@+id/sp_masque_gen_allow_insecure"
                            android:nextFocusDown="@+id/edt_masque_remark"
                            android:textColor="@color/colorText"
                            android:textColorHint="@color/color_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:alpha="0.3"
                        android:background="@color/color_secondary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">

                        <TextView
                            android:id="@+id/tv_masque_remark"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.5"
                            android:text="@string/warp_remark"
                            android:textColor="@color/colorText"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/edt_masque_remark"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_edit_field"
                            android:hint="@string/warp_hint_remark"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:maxLines="1"
                            android:nextFocusLeft="@+id/edt_masque_mtu"
                            android:nextFocusRight="@+id/button_masque_export_to_clip"
                            android:nextFocusUp="@+id/edt_masque_keepalive"
                            android:nextFocusDown="@+id/edt_masque_wnoisedelay"
                            android:textColor="@color/colorText"
                            android:textColorHint="@color/color_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/l_masque_gen_noise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:alpha="0.3"
                    android:background="@color/color_secondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">

                        <TextView
                            android:id="@+id/tv_masque_wnoise"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.5"
                            android:text="@string/warp_wnoise"
                            android:textColor="@color/colorText"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/edt_masque_wnoise"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_edit_field"
                            android:hint="@string/warp_hint_wnoise"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:maxLines="1"
                            android:nextFocusLeft="@+id/edt_masque_wnoise"
                            android:nextFocusRight="@+id/edt_masque_wnoisedelay"
                            android:nextFocusUp="@+id/edt_masque_dns"
                            android:nextFocusDown="@+id/edt_masque_wnoisecount"
                            android:textColor="@color/colorText"
                            android:textColorHint="@color/color_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:alpha="0.3"
                        android:background="@color/color_secondary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">

                        <TextView
                            android:id="@+id/tv_masque_wnoisecount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.5"
                            android:text="@string/warp_wnoisecount"
                            android:textColor="@color/colorText"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/edt_masque_wnoisecount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_edit_field"
                            android:hint="@string/warp_hint_wnoisecount"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:maxLines="1"
                            android:nextFocusLeft="@+id/edt_masque_wnoisecount"
                            android:nextFocusRight="@+id/edt_masque_wpayloadsize"
                            android:nextFocusUp="@+id/edt_masque_wnoise"
                            android:nextFocusDown="@+id/edt_masque_wnoisecount"
                            android:textColor="@color/colorText"
                            android:textColorHint="@color/color_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="10dp">

                        <TextView
                            android:id="@+id/tv_masque_wnoisedelay"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.5"
                            android:text="@string/warp_wnoisedelay"
                            android:textColor="@color/colorText"
                            android:textSize="14sp" />

                        <EditText
                            android:id="@+id/edt_masque_wnoisedelay"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_edit_field"
                            android:hint="@string/warp_hint_wnoisedelay"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:maxLines="1"
                            android:nextFocusLeft="@+id/edt_masque_wnoise"
                            android:nextFocusRight="@+id/button_masque_add_this_config"
                            android:nextFocusUp="@+id/edt_masque_remark"
                            android:nextFocusDown="@+id/edt_masque_wpayloadsize"
                            android:textColor="@color/colorText"
                            android:textColorHint="@color/color_secondary"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:alpha="0.3"
                        android:background="@color/color_secondary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
